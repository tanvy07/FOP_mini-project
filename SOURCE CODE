LOW STOCKS ALERT:-
#include <stdio.h>
struct Item
{
    int id;
    int quantity;
    int threshold;
};
int main()
{
    struct Item items[5] =
    {
        {101,40,15},
        {102,35,15},
        {103,8,10},
        {104,5,8},
        {105,50,20}
    };
    int i;
    printf("LOW STOCK ALERT\n");
    for(i = 0; i < 5; i++) {
        if(items[i].quantity <= items[i].threshold)
        {
            printf("Item ID %d is LOW in stock (Qty: %d)\n",
                   items[i].id, items[i].quantity);
        }
    }
    return 0;
}
